{
  "name": "imagine-quest-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf lib",
    "serve": "npm run build && firebase emulators:start --only auth,firestore,functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions,firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2"
  }
}
